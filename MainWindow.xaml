<Window x:Class="Ostrovok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Ostrovok.Views"
        Title="Островок" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Manual" Width="640" Height="396"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border x:Name="Pill" Width="230" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="{DynamicResource Bg}" CornerRadius="18" ClipToBounds="True"
            BorderBrush="{DynamicResource Edge}" BorderThickness="1">
        <Grid>
            <!-- Блик «стекла» -->
            <Border x:Name="Sheen" IsHitTestVisible="False" Background="{DynamicResource Sheen}" CornerRadius="18"/>
            <!-- Свёрнутый вид -->
            <Grid x:Name="Compact" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="CompactChar" Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center"/>
                <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"/>
                <ContentControl x:Name="CompactRight" Grid.Column="2" VerticalAlignment="Center"/>
            </Grid>
            <!-- Развёрнутый вид -->
            <DockPanel x:Name="Expanded" Width="572" Height="352" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <!-- Шапка как в Atoll: точки страниц + название; при наведении точки превращаются в значки вкладок.
                     Справа — персонаж, часы, кнопки и «свернуть». -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10" Height="34">
                    <Grid x:Name="TabArea" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent">
                        <StackPanel x:Name="PageDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <StackPanel x:Name="DotsRow" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PageTitle" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg}"/>
                        </StackPanel>
                        <StackPanel x:Name="TabBar" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel x:Name="HeadRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ContentControl x:Name="ExpChar" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ExpTime" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Fg}"/>
                        <StackPanel x:Name="BarRight" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="Host"/>
            </DockPanel>
            <!-- Праздник: гирлянда и сугроб поверх содержимого -->
            <v:Garland x:Name="Garland" Visibility="Collapsed"/>
            <v:SnowCap x:Name="SnowCap" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
